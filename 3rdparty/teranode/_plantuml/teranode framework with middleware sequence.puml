@startuml framework messaging routing

title Framework Message Routing with Middleware
hide footbox


entity "BSV\nNetwork" as bsv

participant "Bitcoin\nServer Network" as bsn <<component>>
participant "Event\nBus" as eventbus <<external>>
participant "Message\nHandler" as handlerc1 <<pipeline>>
participant "Bitcoin\nComponent" as componentc1 <<component>>
participant "Message\nHandler" as handlerc2 <<pipeline>>
participant "Bitcoin\nComponent" as componentc2 <<component>>


loop Messages received by Teranode
|||
    bsv --> bsn : bitcoin protocol\nmessage received
    activate bsn
        bsn --> bsn : deserialise message
        bsn --> eventbus : publish msg_a to topic
    deactivate bsn

|||
end loop
|||
loop message consumed by component
|||
    eventbus --> handlerc1 : consume msg_a
    activate handlerc1
        handlerc1 --> componentc1 : msg_a sent for processing
        activate componentc1
            componentc1 --> componentc1 : do work
            componentc1 --> handlerc1 : return
        deactivate componentc1
        handlerc1 --> eventbus : publish msg_b to topic
    deactivate handlerc1

    eventbus --> handlerc2 : consume msg b
    activate handlerc2
        handlerc2 --> componentc2 : msg_b sent for processing
        activate componentc2
            componentc2 --> componentc2 : do work
            componentc2 --> handlerc2 : return
        deactivate componentc2
        handlerc2 --> eventbus : publish msg_c to topic
    deactivate handlerc2
|||
end loop

@enduml
