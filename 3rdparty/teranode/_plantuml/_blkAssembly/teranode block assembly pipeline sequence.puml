@startuml teranode block assembly pipeline

title Block Assembly Pipeline
hide footbox


'entity "BSV\nNetwork" as bsv

'participant "Bitcoin\nServer Network" as bsn <<component>>
participant "Event Bus" as eventbus <<external>>
participant "ValidateTxResultHandler" as validatetxresulthandler <<pipeline>>
participant "Mempool" as mempool <<component>>
participant "AddToBlockTemplateHandler" as addtoblocktemplatehandler <<pipeline>>
participant "BlockAssembler" as blockassembler <<component>>
participant "BlockTemplate" as blocktemplate <<component>>
participant "TransactionShuffleInfo" as transactionshuffleinfo <<component>>
participant "UtxoSpendHandler" as utxospendhandler <<pipeline>>
participant "CollectUtxoSpendHandler" as collectutxospendhandler <<pipeline>>
participant "UtxoProducerAcceptedHandler" as utxoproducerracceptedhandler <<pipeline>>
participant "UtxoStorage\n(write only)" as utxostorage <<component>>
database "UtxoCache\n(in-memory)" as utxocache <<component>>

|||
loop message published by Mempool ( addToBlockTemplateMsg )
|||
    mempool o-->  validatetxresulthandler : return message
    activate validatetxresulthandler
        validatetxresulthandler --> eventbus : publish addToBlockTemplateMsg
    deactivate validatetxresulthandler
|||
end loop
|||
loop message consumed by BlockAssembler ( addToBlockTemplateMsg )
|||
    |||
    note over validatetxresulthandler
        Instructs BlockAssembler to add transaction to the mining block template identified with
        tmplTipId. Mempool also supplies seqNo, which is an monotonically increasing number.
        BlockAssembler can use the seqNo to identify transaction gaps that are caused by message
        reordering in the framework.
    end note
    |||
    eventbus o--> addtoblocktemplatehandler : consume addToBlockTemplateMsg
    activate addtoblocktemplatehandler
        addtoblocktemplatehandler --> blockassembler : addToBlockTemplateMsg\nsent for processing
        activate blockassembler
            blockassembler --> blocktemplate ** : create if null
            blocktemplate --> transactionshuffleinfo ** : create if null
            blockassembler --> blocktemplate : add transactions
            par
            activate blocktemplate
                blockassembler --> blockassembler : create pipeline\nmessage
                blockassembler --> addtoblocktemplatehandler : return message
        deactivate blockassembler
        addtoblocktemplatehandler --> eventbus : publish getActiveMsg to topic
        deactivate addtoblocktemplatehandler
        |||
        else
        |||
            loop
            |||
                blocktemplate --> transactionshuffleinfo ++: order transactions
                    return ordered transactions
                blocktemplate --> eventbus : publish utxoSpendMsg to topic
            deactivate blocktemplate
        |||
        end loop
    end
|||
end loop
|||
loop message consumed by UtxoStorage ( utxoSpendMsg )
|||
    |||
    note over validatetxresulthandler
        UTXO verifies that coin is accepted and not
        yet spent in the given tmplTipId chain by
        some other transaction.

        AOL Record to spend the utxo is added to the AOL.
    end note
    |||
    eventbus o--> utxospendhandler :  consume utxoSpendMsg
    activate utxospendhandler
        utxospendhandler --> utxostorage : utxoSpendMsg\nsent for processing
        activate utxostorage
            utxostorage --> utxostorage : doSpendUtxo
            utxostorage --> utxospendhandler : return spendResponseData
        deactivate utxostorage
        utxospendhandler --> utxospendhandler : create ReturnUtxoSpendMsg
        utxospendhandler --> eventbus : publish ReturnUtxoSpendMsg
    deactivate utxospendhandler
|||
end loop
|||
loop message consumed by UtxoStorage ( returnUtxoSpendMsg)
|||
    eventbus o--> collectutxospendhandler : consume returnUtxoSpendMsg
    activate collectutxospendhandler
        collectutxospendhandler --> eventbus : publish utxoProducerAcceptMsg
    deactivate collectutxospendhandler
    loop collect utxos for spending
        |||
        note over validatetxresulthandler
            Record to accept transaction’s outputs
            is written into AOL.
        end note
        |||
        eventbus o--> utxoproducerracceptedhandler : consume utxoProducerAcceptedMsg
        activate utxoproducerracceptedhandler
            utxoproducerracceptedhandler --> utxostorage : utxoProducerAcceptMsg\nsent for processing
            activate utxostorage
                utxostorage --> utxostorage : producerAccepted
                utxostorage --> utxoproducerracceptedhandler : return responseMsg
            deactivate utxostorage
            utxoproducerracceptedhandler --> eventbus : publish responseMsg to collection target
        deactivate utxoproducerracceptedhandler
    end loop

|||
end loop
@enduml
