{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Simon",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "miner_waitSeconds": "0",
        "SETTINGS_CONTEXT": "dev.simon"
      },
      "args": ["-coinbase=0", "-seeder=0", "-miner=0"]
    },
    {
      "name": "blockchain",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "x"
      },
      "args": ["-blockchain=1"]
    },
    {
      "name": "tx-blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/txblaster/main.go",
      "env": {
        "grpc_resolver": "k8s",
        "propagation_grpcAddresses": "miner1.ubsv.dev:8084",
        "coinbase_grpcAddress": "coinbase.ubsv.dev:8093",
      },
      "args": ["-workers=1", "-print=1"],
    },
    {
      "name": "Remote Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 4040,
      "host": "127.0.0.1",
    }
  ]
}
