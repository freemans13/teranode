{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "main",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "lll",
      },
      "args": ["-blockchain=1"]
    },
    {
      "name": "server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "env": {
        "seeder_grpcAddress": "localhost:9999"
      },
      "args": ["-validator=1", "-propagation=1", "-utxostore=1", "-seeder=1"]
    },
    {
      "name": "tx-blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/txblaster/main.go",
    },
    {
      "name": "client",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/poc/client/client.go"
    },
    {
      "name": "validation_spike",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/playground/validation_spike/main.go"
    },
    {
      "name": "aero_spike",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/poc/aero_tls/main.go"
    },
    {
      "name": "validation_spike",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/playground/validation_spike/main.go"
    },
    {
      "name": "Remote Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 4040,
      "host": "127.0.0.1",
    }
  ]
}