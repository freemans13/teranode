{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "main",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go"
    },
    {
      "name": "server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "env": {
        "seeder_grpcAddress": "localhost:9999"
      },
      "args": ["-validator=1", "-propagation=1", "-utxostore=1"]
    },
    {
      "name": "blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "env": {
        "seeder_grpcAddress": "localhost:9999",
        "profilerAddr": "localhost:9092",
        "blaster_enabled": "true"
      },
      "args": ["-validator=1"]
    },
    {
      "name": "client",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/poc/client/client.go"
    },
    {
      "name": "validation_spike",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/playground/validation_spike/main.go"
    },
    {
      "name": "validation_spike",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/playground/validation_spike/main.go"
    },
    {
      "name": "Remote Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 4040,
      "host": "127.0.0.1",
    }
  ]
}