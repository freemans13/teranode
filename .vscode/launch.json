{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UBSV",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      // "buildFlags": "-tags=aerospike",
      "env": {
        "asset_httpAddress": "http://localhost:8090",
        "startLegacy": "true",
      },
      "args": [
        "-legacy=0"
        // "-faucet=1",
        // "-blockchain=1",
        // "-asset=1",
        // "-coinbase=1",
        // "-all=1"
      ]
    },
    {
      "name": "UBSV - docker.ci.ubsv3",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      // "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "docker.ci.ubsv3.debug"
      },
      "args": [
        "-legacy=0"
        // "-faucet=1",
        // "-blockchain=1",
        // "-asset=1",
        // "-coinbase=1",
        // "-all=1"
      ]
    },
    {
      "name": "Legacy",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      // "buildFlags": "-tags=aerospike",
      "env": {
        "asset_httpAddress": "http://localhost:8090",
        "startLegacy": "true",
        "blockassembly_disabled": "true",
        "legacy_verifyOnly": "false",
        "profilerAddr": ":6060",
      },
      "args": [
        "-all=0",
        // "-blockchain=1",
        "-legacy=1",
        // "-blockvalidation=1",
        // "-subtreevalidation=1"
        // "-faucet=1",
        // "-blockchain=1",
        // "-asset=1",
        // "-coinbase=1",
        // "-all=1"
      ]
    },
    {
      "name": "Rpc",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      // "buildFlags": "-tags=aerospike",
      "env": {
        "blockassembly_disabled": "true",
      },
      "args": [
        "-all=0",
        "-rpc=1",
        "-blockchain=1",
      ]
    },
    {
      "name": "UBSV - aerospike",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "dev",
        "asset_httpAddress": "http://localhost:8090",
        // "utxostore": "aerospike://localhost:3000/test?timeout=30s",
        // "txmeta_store": "aerospike://localhost:3000/test?timeout=30s"
      },
      "args": [
        "-blockchain=0",
        "-utxostore=0",
        "-txmetastore=0",
        "-Asset=0",
        "-coinbase=0",
        "-miner=0",
        "-blockvalidation=0",
        "-blockassembly=0",
        "-validator=0",
        "-propagation=1",
        "-bootstrap=0",
        "-p2p=0"
      ]
    },
    {
      "name": "coinbase",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      // "buildFlags": "-tags=aerospike",
      "env": {
        "grpc_resolver": "dns",
        "logLevel": "DEBUG",
        "XSETTINGS_CONTEXT": "allinone.coinbase.7",
      },
      "args": [
        "-blockchain=0",
        "-utxostore=0",
        "-txmetastore=0",
        "-Asset=0",
        "-coinbase=1",
        "-miner=0",
        "-blockvalidation=0",
        "-blockassembly=0",
        "-validator=0",
        "-propagation=1",
        "-bootstrap=0",
        "-p2p=0"
      ]
    },
    {
      "name": "propagation_blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/propagation_blaster/main.go",
      "buildFlags": "-tags=native",
      "env": {},
      "args": [
        "-broadcast=grpc"
      ]
    },
    {
      "name": "blockassembly_blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/blockassembly_blaster/main.go",
      "env": {},
      "args": [
        "-broadcast=frpc"
      ]
    },
    {
      "name": "aerospiketest",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/aerospiketest/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "utxostore": "aerospike://localhost:3000/testtimeout=30s",
      },
      "args": [
        "-strategy=direct",
        "-transactions=1000",
        "-workers=10",
        "-timeout=30s",
        "-aerospike_host=localhost:3000"
      ]
    },
    {
      "name": "blockchain",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "x"
      },
      "args": [
        "-blockchain=1"
      ]
    },
    {
      "name": "bootstrap",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "x",
        "bootstrap_httpListenAddress": "localhost:8099"
      },
      "args": [
        "-bootstrap=1"
      ]
    },
    {
      "name": "tx-blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/txblaster/main.go",
      "args": [
        "-workers=1",
        "-print=1"
      ]
    },
    {
      "name": "s3-blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/s3_blaster/main.go",
      "env": {
        "logLevel": "DEBUG",
        "SETTINGS_CONTEXT": "dev.stu"
      },
      "args": [
        "-workers=1"
      ]
    },
    {
      "name": "tx-blaster-miner7",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/txblaster/main.go",
      "env": {
        "Xgrpc_resolver": "k8s",
        "logLevel": "DEBUG",
        "SETTINGS_CONTEXT": "allinone.miner.7",
        "Xpropagation_grpcAddresses": "miner1.allinone.ubsv.dev:8084",
        "Xcoinbase_grpcAddress": "miner1.allinone.ubsv.dev:8093"
      },
      "args": [
        "-workers=1",
        "-print=1"
      ]
    },
    {
      "name": "utxostore_blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "buildFlags": "-tags=aerospike",
      "program": "${workspaceFolder}/cmd/utxostore_blaster/main.go",
      "env": {
        "utxostore": "aerospike://localhost:3000/test",
        "utxoblaster_utxostore_redis": "redis://13.51.121.65:6379,13.51.205.122:6379"
      },
      "args": [
        "-workers=10",
        "-store=redis-ring"
      ]
    },
    {
      "name": "filereader",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "buildFlags": "-tags=aerospike",
      "program": "${workspaceFolder}/cmd/filereader/main.go",
      // "args": ["../../data/blockpersister/00d07e632c0db3fc18f43c47238db5162d4e8589c4fbc25dc2d84b4ca5a6d63a_0.utxodiff"]
      "args": [
        "003981438894b73b4ec829a9c4a895c064a1aad82e03966b3a88172060f25546.block"
      ],
      "env": {
        "blockstore": "s3:///eu-ubsv-block-store?region=eu-west-1",
      }
    },
    {
      "name": "binserve",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/poc/binserve/main.go",
    },
    {
      "name": "Remote Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 4040,
      "host": "127.0.0.1"
    }
  ]
}