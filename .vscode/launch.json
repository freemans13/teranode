{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UBSV",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      // "buildFlags": "-tags=aerospike",
      "env": {
        "blobserver_httpAddress": "http://localhost:8090",
        "securityLevel": "0",
        "feature_libP2P": "true",
        "miner_waitSeconds":"30"
      },
      "args": [
        "-blockchain=1",
        "-utxostore=0",
        "-txmetastore=0",
        "-blobserver=1",
        "-coinbase=1",
        "-miner=1",
        "-blockvalidation=1",
        "-blockassembly=1",
        "-validator=1",
        "-propagation=1",
        "-bootstrap=0",
        "-p2p=1"
      ]
    },
    {
      "name": "propagation_blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/propagation_blaster/main.go",
      "buildFlags": "-tags=native",
      "env": {},
      "args": ["-broadcast=grpc"]
    },
    {
      "name": "blockassembly_blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/blockassembly_blaster/main.go",
      "env": {},
      "args": ["-broadcast=frpc"]
    },
    {
      "name": "aerospiketest",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/aerospiketest/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "x"
      },
      "args": ["-strategy=direct", "-transactions=1000", "-workers=10", "-timeout=30s"]
    },
    {
      "name": "blockchain",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/main.go",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "x"
      },
      "args": ["-blockchain=1"]
    },
    {
      "name": "bootstrap",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/.",
      "buildFlags": "-tags=aerospike",
      "env": {
        "SETTINGS_CONTEXT": "x",
        "bootstrap_httpListenAddress": "localhost:8099"
      },
      "args": ["-bootstrap=1"]
    },
    {
      "name": "tx-blaster",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/txblaster/main.go",
      "env": {
        "Xgrpc_resolver": "k8s",
        "logLevel": "DEBUG",
        "SETTINGS_CONTEXT": "allinone.miner.1",
        "propagation_grpcAddresses": "miner1.allinone.ubsv.dev:8084",
        "coinbase_grpcAddress": "miner1.allinone.ubsv.dev:8093"
      },
      "args": ["-workers=1000", "-print=1000"]
    },
    {
      "name": "Remote Debug",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 4040,
      "host": "127.0.0.1"
    }
  ]
}
